{
  "name": "dodge-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --format=esm --platform=node --outfile=.smoke.mjs --log-level=error && node .smoke.mjs",
    "boot": "esbuild scripts/boot.ts --bundle --format=esm --platform=node --loader:.css=text --outfile=.boot.mjs --log-level=error && node .boot.mjs",
    "survival": "esbuild scripts/survival.ts --bundle --format=esm --platform=node --outfile=.survival.mjs --log-level=error && node .survival.mjs",
    "check": "npm run typecheck && npm run smoke && npm run boot",
    "standalone": "npm run typecheck && esbuild src/main.ts --bundle --format=iife --minify --target=es2020 --outdir=.standalone --loader:.css=css --log-level=warning && node scripts/standalone.mjs",
    "levelcurve": "esbuild scripts/levelcurve.ts --bundle --format=esm --platform=node --outfile=.levelcurve.mjs --log-level=error && node .levelcurve.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
